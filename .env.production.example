# Brand Intelligence -- Production Secrets
# Copy this file to .env on your server, fill in every value, and keep it secret.

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://user:password@localhost:27017/brand_intel?authSource=brand_intel
MONGO_DB_NAME=brand_intel

# ── CORS ──────────────────────────────────────────────────────────────────────
# The exact origin your browser UI is served from (no trailing slash)
CORS_ALLOW_ORIGINS=https://your-dashboard.yourdomain.com

# ── Webhooks (optional) ───────────────────────────────────────────────────────
WEBHOOK_ALLOWED_HOSTS=your-saas-backend.com
WEBHOOK_SECRET=generate-a-long-random-string-here

# ── SMTP Alerts (optional) ────────────────────────────────────────────────────
SMTP_HOST=smtp.yourmailprovider.com
SMTP_PORT=587
SMTP_USER=alerts@yourdomain.com
SMTP_PASS=your-smtp-password
ALERT_EMAILS=soc@yourdomain.com,ops@yourdomain.com
ALERT_FROM=brand-intel@yourdomain.com

# ── Platform Credentials ─────────────────────────────────────────────────────
YOUTUBE_API_KEY=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Whether the round-robin discovery/analysis engine starts itself the moment
# this process boots, or stays paused until someone clicks Start in the
# Scheduler tab (also toggleable there, at runtime). true = today's behavior.
SCHEDULER_AUTOSTART=true
