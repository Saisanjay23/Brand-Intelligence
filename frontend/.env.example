# Where the frontend sends /api and /ws requests.
#
# Leave empty (default) to call same-origin relative paths -- this is
# correct when the frontend is served from the same host as the backend,
# or during `npm run dev`, where vite.config.ts proxies /api to the
# backend for you.
#
# Set this when the frontend is deployed separately from the backend
# (its own static host, a different port, a different machine). The
# backend's CORS is already open (see backend/main.py), so a direct
# cross-origin call works with no proxy involved.
#
# VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=
