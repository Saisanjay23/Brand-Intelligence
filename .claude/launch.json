{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "backend.main:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 5173
    },
    {
      "// ": "Single-origin full stack: the backend serves frontend/dist itself",
      "//  ": "(run `npm run build --prefix frontend` first). Useful for checking",
      "//   ": "the app exactly as deployed, and for a second instance alongside",
      "//    ": "the one on 8000.",
      "name": "app",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "backend.main:app", "--port", "8010"],
      "port": 8010
    }
  ]
}
